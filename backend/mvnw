#!/bin/sh
DIR="$(cd "$(dirname "$0")" && pwd)"
MAVEN_DIR="$DIR/.mvn/apache-maven/apache-maven-3.9.6"

if [ ! -f "$MAVEN_DIR/bin/mvn" ]; then
    if ! command -v mvn >/dev/null 2>&1; then
        echo "[INFO] Apache Maven not detected. Downloading portable Maven 3.9.6..."
        mkdir -p "$DIR/.mvn"
        curl -sSL "https://archive.apache.org/dist/maven/maven-3/3.9.6/binaries/apache-maven-3.9.6-bin.zip" -o "$DIR/.mvn/maven.zip"
        unzip -q -o "$DIR/.mvn/maven.zip" -d "$DIR/.mvn/apache-maven"
        rm -f "$DIR/.mvn/maven.zip"
        chmod +x "$MAVEN_DIR/bin/mvn"
    fi
fi

if [ -f "$MAVEN_DIR/bin/mvn" ]; then
    exec "$MAVEN_DIR/bin/mvn" "$@"
else
    exec mvn "$@"
fi
